@@ -0,0 +1,8 @@
+// The old Tabler icon font, mapped to NeatSystem's icon set (lucide).
+import { ArrowLeft, ArrowRight, House, Info, Link, Lock, LogIn, Pencil, Plus, Search, Trash2, Upload, Users, Globe, X } from 'lucide-react'
+
+const MAP = { 'arrow-left': ArrowLeft, 'arrow-right': ArrowRight, 'brand-google': LogIn, home: House, 'info-circle': Info, link: Link, lock: Lock, pencil: Pencil, plus: Plus, search: Search, trash: Trash2, upload: Upload, users: Users, world: Globe, x: X }
+export default function Ti({ n, className, size = 18 }) {
+  const I = MAP[n] ?? Info
+  return <I className={className} size={size} aria-hidden="true" />
+}
diff --git a/src/lib/nav.js b/src/lib/nav.js
new file mode 100644
index 0000000..3c033c9
--- /dev/null
+++ b/src/lib/nav.js
@@ -0,0 +1,12 @@
+// Where NEATHUB lives inside NeatSystem's hash router: '#/neathub' (host.base).
+// Every route of NEATHUB is BASE + its old path: '#/neathub/software/vision', '#/neathub/admin'.
+let base = '#/neathub'
+export const setBase = (b) => { base = '#' + (b || '/neathub') }
+export const BASE = () => base
+export const href = (path = '') => (path ? `${base}/${path}` : base)
+/** The part of the hash after BASE, without slashes at the ends. */
+export function currentPath() {
+  const h = decodeURI(location.hash)
+  if (!h.startsWith(base)) return ''
+  return h.slice(base.length).replace(/^\/+|\/+$/g, '')
+}
